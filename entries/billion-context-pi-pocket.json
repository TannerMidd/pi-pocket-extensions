{
    "name": "billion-context-pi-pocket",
    "title": "Billion context",
    "description": "Context compression with per-chat controls and guarded exports. Owner Install/Update downloads hash-pinned billion-context-pi from registry.npmjs.org (0.9 MB; allow about 10 MB during setup; older versions stay cached). Check for updates reads public data from api.github.com and raw.githubusercontent.com and sends no user data. Program and ACP state use Pocket's data folder. Reads user/project Pi ACP config, writes Pi's ACP log, and uses ~/.cache/pi/acp-decompress for automatic restores. No npm scripts run.",
    "tags": [
        "context",
        "compression",
        "memory"
    ],
