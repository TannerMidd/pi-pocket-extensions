{
    "name": "resource-queue",
    "title": "Resource queue",
    "description": "Monitor memory, CPU load, I/O wait, data-disk space, and top Linux processes. Pause tool calls across sessions and stagger waiting admissions with a configurable resume delay. Reads /proc/stat and per-process stat, status, and io counters; never command arguments. Uses the experimental linked-session, settings, and browser status APIs. No external network calls.",
    "tags": [
        "resources",
        "monitoring",
        "queue",
        "linux"
    ],
